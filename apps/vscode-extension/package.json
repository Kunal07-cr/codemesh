{
  "name": "codemesh-vscode",
  "displayName": "Codaventra",
  "description": "Source-linked repository search, impact analysis, and graph navigation for Codaventra.",
  "version": "0.1.0",
  "private": true,
  "publisher": "codemesh",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:codemesh.openGraph",
    "onCommand:codemesh.explainSelection",
    "onCommand:codemesh.showImpact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codemesh.openGraph",
        "title": "Codaventra: Open Repository Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codemesh.explainSelection",
        "title": "Codaventra: Explain Selection",
        "icon": "$(sparkle)"
      },
      {
        "command": "codemesh.showImpact",
        "title": "Codaventra: Show File Impact",
        "icon": "$(references)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codemesh.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        },
        {
          "command": "codemesh.showImpact",
          "when": "editorTextFocus",
          "group": "navigation@21"
        }
      ]
    },
    "configuration": {
      "title": "Codaventra",
      "properties": {
        "codemesh.endpoint": {
          "type": "string",
          "default": "http://localhost:4200/api/mcp",
          "description": "Codaventra MCP HTTP endpoint."
        },
        "codemesh.token": {
          "type": "string",
          "default": "",
          "markdownDescription": "Scoped token created in the Codaventra Delivery Hub. Treat it as a secret."
        },
        "codemesh.projectId": {
          "type": "string",
          "default": "project-sample-taskpilot",
          "description": "Codaventra project ID used for graph links."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js"
  }
}

