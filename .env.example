# Core
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4200
API_PORT=4200
SESSION_SECRET=replace-with-a-strong-random-secret
APP_PUBLIC_URL=http://localhost:4200
DATA_PATH=storage/codemesh-dev.json
METRICS_TOKEN=replace-with-a-monitoring-token
AI_REQUESTS_PER_MINUTE=60
JOB_CONCURRENCY=2
SANDBOX_EXECUTION_ENABLED=false
SANDBOX_TIMEOUT_MS=30000

# Database and infrastructure for production-oriented runs
DATABASE_URL=postgresql://codemesh:codemesh@localhost:5432/codemesh?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=codemesh
S3_ACCESS_KEY_ID=codemesh
S3_SECRET_ACCESS_KEY=codemesh-secret
S3_FORCE_PATH_STYLE=true

# Optional account-email webhook. Receives password-reset and verification links as JSON.
EMAIL_WEBHOOK_URL=

# Gemini provider. Leave unset to use the deterministic local demo provider.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Any OpenAI-compatible chat endpoint (Ollama, vLLM, OpenRouter, Together, Groq).
# When configured, this provider takes priority over Gemini.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=qwen2.5:14b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_SYSTEM_PROMPT=You are CodeMesh, a careful repository assistant. Use supplied repository evidence and admit uncertainty.
MAX_CONTEXT_MESSAGES=30
# Optional override. The bundled synthetic intelligence dataset is loaded by default.
ASSISTANT_DATASET_PATH=

# GitHub App integration. Leave unset to show the honest not-configured state.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_BASE64=

# Optional enterprise identity controls surfaced in Delivery Hub.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SCIM_BEARER_TOKEN=

